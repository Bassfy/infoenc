# INFOENC core-api environment (Phase 5). Copy to .env for local dev; never commit .env.
# Values validated at boot by services/core-api/src/config/env.ts — the process refuses to
# start on an invalid/missing config (NFR-015).

NODE_ENV=development
PORT=4000

# Postgres — local dev uses the docker-compose credentials. In prod the app connects as the
# non-BYPASSRLS `infoenc_app` role (Phase 3 doc 04 §3); migrations use a separate migrator role.
DATABASE_URL=postgresql://infoenc:infoenc_dev@localhost:5432/infoenc

REDIS_URL=redis://localhost:6379

# JWT signing — local dev may point at a file-based key; prod uses a KMS key id (doc 05 §3).
JWT_SIGNING_KEY_ID=local-dev-key
JWT_ISSUER=http://localhost:4000
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=2592000

# Envelope-encryption root key for field-level encryption of crown-jewel data (NFR-020).
KMS_DATA_KEY_ID=local-dev-data-key

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
