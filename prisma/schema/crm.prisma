// CRM — leads, pipeline, activities (Phase 2 doc 03 crm module, FR-AD-020s).

model Lead {
  id             String          @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  // becomes linked to an org once won/onboarded; null while a raw lead
  orgId          String?         @db.Uuid
  org            Organization?   @relation(fields: [orgId], references: [id], onDelete: SetNull)
  companyName    String?
  contactName    String?
  contactEmail   String
  stage          LeadStage       @default(new)
  temperature    LeadTemperature @default(cold)
  score          Int             @default(0) // qualification score (FR-AU-010)
  // service interest + scoping payload (from FR-CO-020 forms) typed in contracts
  interest       EngagementType?
  scopingData    Json            @default("{}")
  // source attribution (UTM, referrer, campaign)
  source         Json            @default("{}")
  estimatedValue Int? // minor units
  currency       String?
  lostReason     String?
  ownerId        String?         @db.Uuid // assigned consultant
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  activities LeadActivity[]
  proposals  Proposal[]

  @@index([stage, temperature])
  @@index([ownerId])
  @@map("leads")
}

model LeadActivity {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  leadId    String   @db.Uuid
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind      String // "email" | "call" | "meeting" | "note" | "stage_change"
  body      String?
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model Proposal {
  id               String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  leadId           String    @db.Uuid
  lead             Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  // draft generated by FR-AU-011, then consultant-reviewed
  status           String    @default("draft") // draft|sent|viewed|signed|expired
  currency         String
  amount           Int
  pdfUrl           String?
  generatedByRunId String?   @db.Uuid // automation run trace linkage
  sentAt           DateTime?
  viewedAt         DateTime?
  signedAt         DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([leadId, status])
  @@map("proposals")
}
